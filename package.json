{
  "name": "whatsapp-ai",
  "productName": "WhatsApp AI",
  "version": "1.0.19",
  "private": true,
  "description": "WhatsApp Web on the desktop, with English/Hebrew translation and {} AI instructions",
  "author": "Kenny Green",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && node e2e/run.mjs",
    "icons": "node scripts/icons.mjs",
    "release": "node scripts/release.mjs",
    "release:public": "node scripts/release.mjs --public"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.19.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "luxon": "^3.7.2",
    "playwright-core": "^1.64.1",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.35.5",
    "tinyld": "^1.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.ekgir.whatsappai",
    "productName": "WhatsApp AI",
    "copyright": "Kenny Green",
    "directories": {
      "output": "C:/dev/whatsapp-ai-build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WhatsApp AI",
      "artifactName": "WhatsApp-AI-Setup-${version}.exe"
    }
  }
}
